{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "CustomerEvent",
    "type":"object",
    "required": [   "event_id","event_type",
                    "customer_id","event_timestamp"], 
    "properties": {
        "event_id":{"type": "string","format": "uuid"},
        "event_type":{"type":"string","enum": ["customer_created","customer_updated"]},
        "customer_id":{"type":"string","format": "uuid"},
        "first_name":{"type":["string","null"],"maxLength": 100},
        "email":{"type":["string","null"], "maxLength": 225},
        "phone_number":{"type":["string","null"], "maxLength": 30},
        "city":{"type":["string","null"], "maxLength": 50},
        "state":{"type":["string","null"], "maxLength": 50},
        "country":{"type":["string","null"], "maxLength": 50},
        "customer_segment":{"type":["string","null"],"maxLength": 50},
        "event_timestamp":{"type":["string"], "format": "date-time"}
    },
    "additionalproperties":false
}